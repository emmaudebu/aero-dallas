{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "navy", "name": "Navy", "color": "#152D63" },
				{ "slug": "navy-deep", "name": "Deep navy", "color": "#0C1B3F" },
				{ "slug": "orange", "name": "Orange", "color": "#FE7620" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "mist", "name": "Mist (section background)", "color": "#F2F4F8" },
				{ "slug": "line", "name": "Line", "color": "#D7DDE8" },
				{ "slug": "slate", "name": "Slate (body text)", "color": "#3D475A" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"spacing": {
			"units": [ "px", "rem", "%" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "2.5rem" },
				{ "slug": "60", "name": "XL", "size": "4rem" },
				{ "slug": "70", "name": "XXL", "size": "6rem" }
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Archivo Black",
					"fontFamily": "\"Archivo Black\", \"Arial Black\", sans-serif"
				},
				{
					"slug": "body",
					"name": "Open Sauce One",
					"fontFamily": "\"Open Sauce One\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "1.375rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "clamp(1.75rem, 3vw, 2.5rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--slate)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--navy)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.1"
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--navy)" }
			}
		}
	}
}
